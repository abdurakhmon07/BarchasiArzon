{
  "name": "barchasi-arzon",
  "version": "1.0.0",
  "description": "Barchasi Arzon - Telegram household products catalog (bot + admin panel)",
  "license": "ISC",
  "author": "abdurakhmon07",
  "type": "commonjs",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "start:dev": "nodemon --watch src -e ts,ejs,css --exec ts-node src/server.ts",
    "build": "tsc && cp -r src/views src/public dist/",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "connect-mongodb-session": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "grammy": "^1.46.0",
    "mongoose": "^8.24.9",
    "morgan": "^1.12.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
