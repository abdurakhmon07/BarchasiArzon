{
  "name": "barchasi-arzon",
  "version": "1.0.0",
  "description": "Barchasi Arzon - Telegram shop on Cloudflare Workers (Hono + D1 + grammY) with a React Mini App",
  "license": "ISC",
  "author": "abdurakhmon07",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:app": "npm --prefix telegram-app run dev",
    "build": "npm --prefix telegram-app install && npm --prefix telegram-app run build",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:dev": "npm run build && wrangler deploy --env dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "import:mongo": "node scripts/import-from-mongo.ts",
    "typecheck": "tsc --noEmit && npm --prefix telegram-app run typecheck"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "mongodb": "^6.22.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  }
}
