<%- include("../includes/header", { title: "Products" }) %>

<div class="page-head">
  <h1>Products <span class="count"><%= products.length %></span></h1>
  <a class="btn btn-primary" href="/admin/products/new">+ Add product</a>
</div>

<form class="filters" method="get" action="/admin/products">
  <input type="search" name="q" placeholder="Search by name…" value="<%= filter.search %>" />
  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach(c => { %>
      <option value="<%= c._id %>" <%= String(c._id) === filter.categoryId ? "selected" : "" %>><%= c.nameUz %></option>
    <% }) %>
  </select>
  <select name="section">
    <option value="">All sections</option>
    <option value="general" <%= filter.section === "general" ? "selected" : "" %>>General catalog</option>
    <option value="special" <%= filter.section === "special" ? "selected" : "" %>>Special price</option>
  </select>
  <button class="btn" type="submit">Filter</button>
</form>

<% if (!products.length) { %>
  <p class="empty">No products found.</p>
<% } else { %>
<div class="table-wrap">
<table class="products">
  <thead>
    <tr>
      <th></th><th>Name</th><th>Category</th><th class="num">Price</th>
      <th>Status</th><th>Section</th><th>Visible</th><th></th>
    </tr>
  </thead>
  <tbody>
  <% products.forEach(p => { %>
    <tr class="<%= p.isVisible ? "" : "is-hidden" %>">
      <td class="thumb">
        <% if (p.photoFileId) { %>
          <img src="/admin/photo/<%= encodeURIComponent(p.photoFileId) %>" alt="" loading="lazy" />
        <% } else { %><div class="no-photo">—</div><% } %>
      </td>
      <td>
        <a href="/admin/products/<%= p._id %>/edit"><b><%= p.nameUz %></b></a>
      </td>
      <td><%= p.categoryId && p.categoryId.nameUz ? p.categoryId.nameUz : "—" %></td>
      <td class="num"><%= price(p.price) %>
        <% if (p.oldPrice) { %><div class="muted small"><s><%= price(p.oldPrice) %></s> · −<%= p.discountPercent %>%</div><% } %></td>
      <td>
        <form method="post" action="/admin/products/<%= p._id %>/quick" class="inline">
          <input type="hidden" name="action" value="status" />
          <select name="value" class="status status-<%= p.status %>" data-autosubmit>
            <% statuses.forEach(s => { %>
              <option value="<%= s %>" <%= s === p.status ? "selected" : "" %>><%= s.replace(/_/g, " ") %></option>
            <% }) %>
          </select>
        </form>
      </td>
      <td>
        <form method="post" action="/admin/products/<%= p._id %>/quick" class="inline">
          <input type="hidden" name="action" value="special" />
          <input type="hidden" name="value" value="<%= !p.isSpecial %>" />
          <button class="pill <%= p.isSpecial ? "pill-hot" : "" %>" title="Click to move">
            <%= p.isSpecial ? "🔥 Special" : "General" %>
          </button>
        </form>
      </td>
      <td>
        <form method="post" action="/admin/products/<%= p._id %>/quick" class="inline">
          <input type="hidden" name="action" value="visible" />
          <input type="hidden" name="value" value="<%= !p.isVisible %>" />
          <button class="pill <%= p.isVisible ? "pill-ok" : "pill-off" %>" title="Click to toggle">
            <%= p.isVisible ? "Shown" : "Hidden" %>
          </button>
        </form>
      </td>
      <td class="actions">
        <a class="btn btn-small" href="/admin/products/<%= p._id %>/edit">Edit</a>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>

<%- include("../includes/footer") %>
