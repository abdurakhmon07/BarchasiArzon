<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title + " · " : "" %>Barchasi Arzon Admin</title>
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/admin">Barchasi Arzon <span>admin</span></a>
    <% if (admin) { %>
      <nav>
        <a href="/admin/products">Products</a>
        <a href="/admin/categories">Categories</a>
        <span class="who"><%= admin.firstName %></span>
        <a href="/admin/logout">Log out</a>
      </nav>
    <% } %>
  </header>
  <main class="container">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
    <% } %>
