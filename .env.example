# Copy this file to .env and fill in the values.
PORT=3005
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/barchasi-arzon
SESSION_SECRET=change-me-to-a-long-random-string

# Token from @BotFather
BOT_TOKEN=123456:ABC...

# Address where the admin panel is reachable (used in the login link the bot sends)
BASE_URL=http://localhost:3005

# https address of the Mini App (the React app in ~/Desktop/telegram-app).
# In development this is your tunnel URL, e.g. https://xxxx.trycloudflare.com
MINI_APP_URL=

# Comma-separated numeric Telegram user IDs that get role=admin when they press /start
ADMIN_IDS=111111111
