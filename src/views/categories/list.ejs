<%- include("../includes/header", { title: "Categories" }) %>

<div class="page-head">
  <h1>Categories <span class="count"><%= categories.length %></span></h1>
</div>

<form class="card form" method="post" action="/admin/categories">
  <h2>Add category</h2>
  <div class="grid-name-order">
    <label>Name <input name="name" required maxlength="100" placeholder="Tozalash vositalari" /></label>
    <label>Order <input name="sortOrder" type="number" value="0" /></label>
  </div>
  <div class="form-actions"><button class="btn btn-primary" type="submit">Add</button></div>
</form>

<% if (!categories.length) { %>
  <p class="empty">No categories yet. Add the first one above.</p>
<% } else { %>
<% categories.forEach(c => { %>
  <form method="post" action="/admin/categories/<%= c._id %>" id="cat-<%= c._id %>"></form>
<% }) %>
<div class="table-wrap">
<table>
  <thead><tr><th>Name</th><th>Order</th><th class="num">Products</th><th></th></tr></thead>
  <tbody>
  <% categories.forEach(c => { const n = counts[String(c._id)] || 0; %>
    <tr>
      <td><input form="cat-<%= c._id %>" name="name" required maxlength="100" value="<%= c.nameUz %>" /></td>
      <td><input form="cat-<%= c._id %>" name="sortOrder" type="number" class="short" value="<%= c.sortOrder %>" /></td>
      <td class="num"><a href="/admin/products?category=<%= c._id %>"><%= n %></a></td>
      <td class="actions">
        <button form="cat-<%= c._id %>" class="btn btn-small" type="submit">Save</button>
        <form method="post" action="/admin/categories/<%= c._id %>/delete" class="inline"
              data-confirm="Delete category '<%= c.nameUz %>'?">
          <button class="btn btn-small btn-danger" type="submit" <%= n ? "disabled title='Has products'" : "" %>>Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>

<%- include("../includes/footer") %>
