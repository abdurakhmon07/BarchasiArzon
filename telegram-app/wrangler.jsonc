// Cloudflare Workers config for the Mini App.
// Cloudflare runs `npm run build`, then `npx wrangler deploy`, which uploads dist/
// and the small worker that forwards /api/* to the barchasi-arzon backend.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (barchasiarzon.<you>.workers.dev).
  "name": "barchasiarzon",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api requests go through the worker code; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  // BACKEND_URL is set in the dashboard (Settings → Variables and Secrets), not here,
  // so changing the tunnel address doesn't need a new commit. keep_vars stops deploys from deleting it.
  "keep_vars": true
}
